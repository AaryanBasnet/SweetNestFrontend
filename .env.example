# -----------------------------------------------------------------------------
# SweetNest Frontend - environment template
# Copy to .env and adjust:   cp .env.example .env
#
# Only VITE_-prefixed variables reach the browser bundle. Everything in here is
# PUBLIC once the app is built - never put a secret in this file.
# -----------------------------------------------------------------------------

# Base URL of the backend API, including the /api suffix.
VITE_API_BASE_URL=http://localhost:5000/api
