# -----------------------------------------------------------------------------
# SweetNest Frontend - environment template
# Copy to .env and adjust:   cp .env.example .env
#
# Only VITE_-prefixed variables reach the browser bundle. Everything in here is
# PUBLIC once the app is built - never put a secret in this file.
# -----------------------------------------------------------------------------

# Base URL of the backend API, including the /api suffix.
VITE_API_BASE_URL=http://localhost:5000/api

# --- Error tracking (optional) ------------------------------------------------
# Leave blank and Sentry is never initialised. A Sentry DSN is safe to expose
# publicly - it only permits sending events, not reading them - but no OTHER
# secret may ever go in a VITE_ variable.
VITE_SENTRY_DSN=
VITE_SENTRY_RELEASE=
VITE_SENTRY_TRACES_RATE

# --- Demo accounts (optional) -------------------------------------------------
# "true" shows one-click customer/admin demo buttons on the login page. The
# backend must also have DEMO_ACCOUNTS_ENABLED=true, or the buttons get a 404.
VITE_ENABLE_DEMO_LOGIN=false=0.1
